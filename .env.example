# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored and blocked from Apache by .htaccess. Never commit it.

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Database ----------
# Development: `npm run db:local` starts a built-in PostgreSQL on port 5433
# with exactly these credentials (local only, not reachable from the network).
# Production: use your managed PostgreSQL URL.
DATABASE_URL=postgresql://postgres:localdev@localhost:5433/imgapp?schema=public

# ---------- API server ----------
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# Requests per minute per IP across the whole API.
RATE_LIMIT_PER_MINUTE=300
# Number of reverse proxies in front of the API (0 locally, usually 1 in production).
TRUST_PROXY=0
# Signs the visitor cookie. MUST be a long random secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-64-random-hex-characters-see-command-above

# ---------- Storage ----------
# local: files on this machine's disk.
# vercel-blob: private Vercel Blob store (needed on Vercel; also set BLOB_READ_WRITE_TOKEN,
#              which Vercel adds automatically when you connect a Blob store to the project).
STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=
# Relative paths are resolved from the project root.
STORAGE_LOCAL_DIR=storage
# Uploaded files and results are deleted automatically after this many hours.
FILE_RETENTION_HOURS=24

# ---------- Limits ----------
UPLOAD_MAX_MB=25
UPLOAD_MAX_FILES=20
# Images above this many megapixels are rejected (decompression-bomb protection).
MAX_INPUT_MEGAPIXELS=50
MAX_OUTPUT_MEGAPIXELS=100
MAX_OUTPUT_DIMENSION=16384
BATCH_MAX_FILES=50
GUEST_DAILY_JOB_LIMIT=200

# ---------- Worker ----------
# queue: PostgreSQL job queue + worker (servers, development).
# inline: process inside the API request (Vercel and other serverless hosts).
JOB_RUNNER=queue
# true: process images inside the API process (simplest for development).
# false: run `npm run start:worker` separately (recommended in production).
WORKER_EMBEDDED=true
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1
JOB_TIMEOUT_SECONDS=120
# Protects GET /api/cron/cleanup (Vercel Cron sends it as a Bearer token). 16+ characters.
# CRON_SECRET=

# ---------- Web app (NEXT_PUBLIC_* values are visible in the browser) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Pixora
NEXT_PUBLIC_BRAND_TAGLINE=Resize, enhance and perfect your images without compromising quality.

# Proxy mode (website on Vercel, API on another machine or behind a tunnel).
# Set this ONLY on the website host, e.g. in Vercel's Environment Variables:
# the browser then calls /api on the website's own domain and Next.js forwards
# it here. NEXT_PUBLIC_API_URL is ignored when this is set.
# API_PROXY_TARGET=https://your-api-tunnel.example.com
